# AWS Financial Operations Data Pipeline
# Example environment variables for local AWS automation.
# Copy this file to .env for local use, but never commit .env to GitHub.

AWS_REGION=eu-central-1
AWS_S3_BUCKET=aws-finops-reza-saeedi-20260603

# S3 prefixes used by the project data lake
S3_RAW_PREFIX=raw/
S3_PROCESSED_PREFIX=processed/
S3_QUARANTINE_PREFIX=quarantine/
S3_QUALITY_REPORTS_PREFIX=quality_reports/
S3_REPORTS_PREFIX=reports/
S3_CURATED_PREFIX=curated/
S3_ATHENA_RESULTS_PREFIX=athena-results/

# Athena / Glue settings
ATHENA_DATABASE=financial_ops_db
ATHENA_OUTPUT_LOCATION=s3://aws-finops-reza-saeedi-20260603/athena-results/

# Local project paths
LOCAL_RAW_PATH=data/raw
LOCAL_PROCESSED_PATH=data/processed
LOCAL_QUARANTINE_PATH=data/quarantine
LOCAL_QUALITY_REPORTS_PATH=data/quality_reports
LOCAL_REPORTS_PATH=data/reports
LOCAL_CURATED_PATH=data/curated

# Do not put real credentials in this example file.
# Real credentials, if needed locally, must go only in .env.
AWS_ACCESS_KEY_ID=your_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here